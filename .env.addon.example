# Add these to apps/web/.env.local (and to Vercel > Settings > Environment Variables)
CRON_SECRET=make-a-long-random-string
# Email (Resend: https://resend.com). The sender domain must be verified in Resend.
RESEND_API_KEY=
EMAIL_FROM="PLASU Student Affairs <noreply@studentaffairs.plasu.edu.ng>"
# SMS (Termii: https://termii.com). Needs an approved sender ID.
TERMII_API_KEY=
TERMII_SENDER_ID=
TERMII_CHANNEL=generic
